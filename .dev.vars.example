# 复制为 .dev.vars（本地）；生产用 `wrangler secret put <NAME>` 写入
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_SECRET=
# Waffo Pancake（默认支付）
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Dodo Payments（可选）
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Stripe（可选；sk_test_ 或 rk_test_ 开头的 test Key，webhook 签名密钥 whsec_）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# fal.ai 视频生成
# KIE 视频生成（VIDEO_PROVIDER=kie；每个新站单独创建 Key）
KIE_API_KEY=
FAL_KEY=
# yir.ai 视频网关（VIDEO_PROVIDER=yir 时必填）
YIR_API_KEY=
# NanoAPI 视频服务（VIDEO_PROVIDER=nanoapi 时必填）
NANOAPI_API_KEY=
# 图片审核（MODERATION_PROVIDER=openai 时必填）
OPENAI_API_KEY=
# Turnstile（vars.TURNSTILE_SITE_KEY 非空时必填）
TURNSTILE_SECRET_KEY=
# 付款即时通知（可选）：Telegram / 飞书 / Discord / Slack 的 webhook 地址，见 docs/env.md
PAYMENT_NOTIFY_WEBHOOK_URL=
# Resend 发信（可选）：配了且 vars.EMAIL_FROM 非空时，交易邮件改走 Resend（免费档每月 3000 封、每天 100 封），发件域名要先在 Resend 验证；不配则用 send_email binding
RESEND_API_KEY=
